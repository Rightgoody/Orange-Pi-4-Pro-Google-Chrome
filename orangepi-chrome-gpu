#!/bin/bash
wrapper=/opt/google/chrome/google-chrome
[ -f "$wrapper" ] || exit 0
python3 - "$wrapper" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
full = 'exec -a "$0" "$HERE/chrome" --use-gl=angle --use-angle=vulkan --enable-features=Vulkan,VulkanFromANGLE --ignore-gpu-blocklist --disable-features=HistoryEmbeddings,OptimizationGuide,Translate,Prerender,BackgroundFetch,MediaRouter --renderer-process-limit=2 --num-raster-threads=2 "$@"'
candidates = [
    'exec -a "$0" "$HERE/chrome" "$@"',
    'exec -a "$0" "$HERE/chrome" --use-gl=angle --use-angle=vulkan --enable-features=Vulkan,VulkanFromANGLE --ignore-gpu-blocklist "$@"',
]
if full in text:
    raise SystemExit(0)
for old in candidates:
    if old in text:
        path.write_text(text.replace(old, full, 1))
        raise SystemExit(0)
print("orangepi-chrome-gpu: Chrome launcher line changed; flags were not reapplied", file=sys.stderr)
PY
